# Use a managed PostgreSQL database with TLS in production. Never commit real values.
DATABASE_URL=postgresql+psycopg://workforce:CHANGE_ME@localhost:5432/workforce
APP_TIMEZONE=Europe/Brussels

# Optional: configure securely at the deployment host for the mail worker.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=465
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=SET_SECURELY_NOT_IN_GIT
# MAIL_FROM=platform@your-domain.example

# Public HTTPS app address for invite/reset links and QR clock-in scans (no credentials).
# APP_BASE_URL=https://your-app.streamlit.app

# Optional rotating in-store QR clock-in. Keep the secret only in host secrets.
# Enable only after APP_BASE_URL and a random secret of at least 32 characters are set.
# SHIFTFLOW_QR_ENABLED=1
# SHIFTFLOW_QR_SECRET=SET_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Recommended on Streamlit Community Cloud: HTTPS email delivery through Resend.
# RESEND_API_KEY=SET_SECURELY_NOT_IN_GIT
# MAIL_FROM=ShiftFlow <platform@your-verified-domain.example>
# Enable after configuring the provider and verifying a test delivery:
# EMAIL_DELIVERY_ENABLED=1

# Retain new medical certificates for this many days after upload or the final sick day,
# whichever is later. Review your own legal/HR retention policy before setting this.
SICK_NOTE_RETENTION_DAYS=30

# Backup credentials belong in GitHub Actions secrets, not Streamlit or this file:
# BACKUP_DATABASE_URL: direct PostgreSQL connection for the existing production database.
# BACKUP_PASSPHRASE: a separately stored random key, at least 20 characters.

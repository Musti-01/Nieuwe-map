# Use a managed PostgreSQL database with TLS in production. Never commit real values.
DATABASE_URL=postgresql+psycopg://workforce:CHANGE_ME@localhost:5432/workforce
APP_TIMEZONE=Europe/Brussels

# Optional: configure securely at the deployment host for the mail worker.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=465
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=SET_SECURELY_NOT_IN_GIT
# MAIL_FROM=platform@your-domain.example
